# Kairox platform (Arifaa Pack) - every environment variable the code reads.
# Generated from kx.core.settings.CoreSettings (KX_), kx.automation.settings.AutomationSettings (KX_AUTO_),
# arifaa_pack.config.AppSettings (KX_APP_), plus the few variables vendor SDKs and the CMS read directly.
# Copy to .env for local runs. Never commit .env or real credentials. Values shown are the code's defaults,
# except where a line says "local override"; an empty value after '=' means "not set". On the server these are
# Coolify encrypted environment variables (infra/server/stacks/env/pack.env.example).
# Nested settings use a double underscore: KX_AUTH__ENCRYPTION_KEY = CoreSettings.auth.encryption_key.


# ----------------------------------------------------------------------------------------------------
# Paid / free version per field (D41, docs/PLATFORM_MODES.md). PLAN presets every field; __<FIELD> overrides one.
# paid = paid platform first, then the free alternative on our server; free = free alternative only.
KX_PLATFORM_PLAN=free  # local override (code default paid): no vendor keys needed locally
KX_PLATFORM__STT=
KX_PLATFORM__TTS=
KX_PLATFORM__EMAIL=
KX_PLATFORM__LLM=  # paid only
KX_PLATFORM__CALLS=  # paid only (Telnyx); Asterisk later
KX_PLATFORM__WHATSAPP=  # paid only (Meta)
KX_PLATFORM__LLM_STANDBY=none  # none | gemini (OPEN_QUESTIONS #74)
KX_PLATFORM__EMBEDDINGS=bge-m3  # bge-m3 | qwen3 (a change needs `kx reindex`)
KX_PLATFORM__AI_TRACE=phoenix  # phoenix | langfuse

# ----------------------------------------------------------------------------------------------------
# Core (KX_*): environment, databases, Redis, logging. Read by every process (kx.core.settings).
# Databases carry the company prefix (pack_crm ...), like the server (D50). On the server the DSNs point at PgBouncer
# (port 6432) with KX_DB_PGBOUNCER=true; migrations use KX_MIGRATE_<DB>_DSN straight to Postgres.
KX_ENV=local
KX_COMPANY_CODE=pack
KX_COMPANY_TIMEZONE=Asia/Dubai
KX_BASE_CURRENCY=AED
KX_CRM_DSN=postgresql+asyncpg://pack_crm_app:dev@localhost:5432/pack_crm
KX_AUTOMATION_DSN=postgresql+asyncpg://pack_automation_app:dev@localhost:5432/pack_automation
KX_AGENTS_DSN=postgresql+asyncpg://pack_agents_app:dev@localhost:5432/pack_agents
KX_DB_POOL_SIZE=5
KX_DB_MAX_OVERFLOW=5
KX_DB_STATEMENT_TIMEOUT_MS=15000
KX_DB_PGBOUNCER=false
KX_REDIS_URL=redis://localhost:6379/0
KX_TRUSTED_CLIENT_IP_HEADER=  # server: CF-Connecting-IP (D53)

# ----------------------------------------------------------------------------------------------------
# Files on Cloudflare R2 through the S3 API (D45). Empty endpoint = the AWS default chain (tests use fakes).
KX_STORAGE__ENDPOINT_URL=
KX_STORAGE__REGION=auto
KX_STORAGE__ACCESS_KEY_ID=  # secret
KX_STORAGE__SECRET_ACCESS_KEY=  # secret
KX_STORAGE__BUCKET=kx-local

# ----------------------------------------------------------------------------------------------------
# Retention of the Interactions tier (D48, OPEN_QUESTIONS #73). Business data follows the §22 CRM settings.
KX_RETENTION__PLUMBING_DAYS=30
KX_RETENTION__FAILED_JOB_DAYS=90
KX_RETENTION__AGENT_RUNS_MONTHS=13
KX_RETENTION__PARTITION_HOT_MONTHS=6
KX_RETENTION__ARCHIVE=true
KX_RETENTION__BATCH=5000

# ----------------------------------------------------------------------------------------------------
# Staff login (D26, in-house): RS256 signing key and token rules. KX_JWT_PRIVATE_KEY = an RSA private key in PEM
# (newlines as \n); empty in local/test only (a throw-away key is generated). staging/production refuse to start without it.
KX_JWT_ISSUER=http://localhost:8000
KX_JWT_AUDIENCE=kx-crm
KX_JWT_PRIVATE_KEY=  # secret
KX_JWT_KEY_ID=kx-dev-1
KX_JWKS_URL=

# ----------------------------------------------------------------------------------------------------
# Login policy (OPEN_QUESTIONS #50). KX_AUTH__ENCRYPTION_KEY = Fernet key for TOTP seeds:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside local/test.
KX_AUTH__ACCESS_TTL_SECONDS=900
KX_AUTH__REFRESH_TTL_SECONDS=43200
KX_AUTH__MAX_FAILED_ATTEMPTS=5  # M3: per account AND client IP, then that IP is locked out of the account
KX_AUTH__ACCOUNT_LOCK_FAILURES=50  # M3: from all IPs together, then the account itself is locked
KX_AUTH__RESET_MAX_WRONG_CODES=5  # M3: wrong password-reset codes, then recovery is locked for LOCKOUT_MINUTES
# M3 rate limits per route: KX_AUTH__RATE_<LOGIN|MFA_SEND|RESET_START|RESET_FINISH>_<IP|ACCOUNT>__BURST / __PER_MINUTE
# KX_AUTH__CRM_ORIGINS=["https://crm.example.com"]  # M2: browser origins /v1/auth accepts; unset = KX_APP_CORS_ORIGINS
KX_AUTH__LOCKOUT_MINUTES=15
KX_AUTH__CODE_TTL_SECONDS=600
KX_AUTH__CODE_MAX_TRIES=5
KX_AUTH__ENCRYPTION_KEY=  # secret
KX_AUTH__COOKIE_SECURE=false  # local override (code default true): plain-http localhost cookies
KX_AUTH__COOKIE_DOMAIN=
KX_AUTH__TOTP_ISSUER=Kairox CRM

# ----------------------------------------------------------------------------------------------------
# Signs website session tokens and email unsubscribe links. Long random value.
KX_SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret

# ----------------------------------------------------------------------------------------------------
# Logging.
KX_LOG_LEVEL=INFO
KX_LOG_JSON=true

# ----------------------------------------------------------------------------------------------------
# Automation (KX_AUTO_*): WhatsApp Cloud API (Meta, direct). QUOTE_DELIVERY_MINUTES = D32 wait before the email fallback.
KX_AUTO_WHATSAPP__GRAPH_BASE_URL=https://graph.facebook.com
KX_AUTO_WHATSAPP__GRAPH_VERSION=v23.0
KX_AUTO_WHATSAPP__PHONE_NUMBER_ID=
KX_AUTO_WHATSAPP__ACCESS_TOKEN=  # secret
KX_AUTO_WHATSAPP__APP_SECRET=  # secret
KX_AUTO_WHATSAPP__VERIFY_TOKEN=  # secret
KX_AUTO_WHATSAPP__TEMPLATE_LANGUAGE=en
KX_AUTO_WHATSAPP__QUOTE_DELIVERY_MINUTES=10
KX_AUTO_WHATSAPP__SESSION_HOURS=24

# ----------------------------------------------------------------------------------------------------
# Email (D44): Stalwart mail server over JMAP (sends, relaying through SES; buyer replies and bounce reports are
# read from its inbox). Empty URL = Stalwart not configured (the SES API sends directly).
KX_AUTO_STALWART__URL=  # local: http://localhost:8090 (make up-mail); server: http://stalwart:8080
KX_AUTO_STALWART__USERNAME=
KX_AUTO_STALWART__PASSWORD=  # secret
KX_AUTO_STALWART__TIMEOUT_SECONDS=15.0
KX_AUTO_STALWART__POLL_BATCH=25
# M8: Stalwart's authserv-id (its host name, first word of its Authentication-Results header). Set it on a server
# so only Stalwart's own header decides "sender verified"; empty = the topmost header counts. Unverified mail is
# kept and flagged, the AI does not answer it, and the manager and the deal's salesperson are alerted.
KX_AUTO_STALWART__AUTHSERV_ID=

# ----------------------------------------------------------------------------------------------------
# Amazon SES: Stalwart's relay (configured in Stalwart) and the app's backup sender (SES v2 API, `ses:SendEmail`).
# The API backup reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the environment.
KX_AUTO_SES__FROM_ADDRESS=sales@example.com
KX_AUTO_SES__CONFIGURATION_SET=
KX_AUTO_SES__REGION=me-central-1
AWS_ACCESS_KEY_ID=  # secret
AWS_SECRET_ACCESS_KEY=  # secret

# ----------------------------------------------------------------------------------------------------
# Calls (D43): Telnyx TeXML for staff alert calls and click-to-call. Empty API key = calls not configured.
KX_AUTO_TELNYX__API_BASE_URL=https://api.telnyx.com
KX_AUTO_TELNYX__API_KEY=  # secret
KX_AUTO_TELNYX__ACCOUNT_SID=
KX_AUTO_TELNYX__FROM_NUMBER=
KX_AUTO_TELNYX__PUBLIC_KEY=  # secret-ish: Ed25519 public key (base64) to check webhook signatures
KX_AUTO_TELNYX__RING_TIMEOUT_SECONDS=30
KX_AUTO_TELNYX__VOICE=Polly.Joanna
KX_AUTO_TELNYX__LANGUAGE=en-US
KX_AUTO_TELNYX__CALLBACK_TTL_SECONDS=7200
KX_AUTO_TELNYX__CALLBACK_SECRET=  # secret: signs the per-call callback URLs

# ----------------------------------------------------------------------------------------------------
# Staff alerts (§16): hours and the approved WhatsApp template names.
KX_AUTO_ALERTS__WINDOW_START=08:00
KX_AUTO_ALERTS__WINDOW_END=22:00
KX_AUTO_ALERTS__TIMEZONE=Asia/Dubai
KX_AUTO_ALERTS__APPROVAL_REQUEST_TEMPLATE=approval_request
KX_AUTO_ALERTS__APPROVAL_REMINDER_TEMPLATE=approval_reminder
KX_AUTO_ALERTS__CHANGE_REQUEST_TEMPLATE=change_request
KX_AUTO_ALERTS__ESCALATION_TEMPLATE=approval_escalation
KX_AUTO_ALERTS__NEGOTIATION_PAUSED_TEMPLATE=negotiation_paused
KX_AUTO_ALERTS__NOTICE_TEMPLATE=staff_notice
KX_AUTO_ALERTS__FINAL_QUOTE_TEMPLATE=final_quote_alert
KX_AUTO_ALERTS__THANK_YOU_TEMPLATE=thank_you
KX_AUTO_ALERTS__ORDER_UPDATE_TEMPLATE=order_update
KX_AUTO_ALERTS__REQUIREMENT_SUMMARY_TEMPLATE=requirement_summary

# ----------------------------------------------------------------------------------------------------
# Buyer follow-ups (§16): contact hours, weekly cap, template per step (JSON object).
KX_AUTO_FOLLOWUP__WINDOW_START=09:00
KX_AUTO_FOLLOWUP__WINDOW_END=18:00
KX_AUTO_FOLLOWUP__MAX_PER_WEEK=2
KX_AUTO_FOLLOWUP__DEFAULT_TIMEZONE=Asia/Dubai
KX_AUTO_FOLLOWUP__TEMPLATES={"followup_d2": "followup_1", "followup_d5": "followup_2", "followup_d10": "followup_3", "reorder": "reorder_reminder", "custom": "followup_1"}

# ----------------------------------------------------------------------------------------------------
# Outbound rate limits (Redis token buckets).
KX_AUTO_RATE_LIMIT__RECIPIENT_CAPACITY=6
KX_AUTO_RATE_LIMIT__RECIPIENT_REFILL_PER_MINUTE=2.0
KX_AUTO_RATE_LIMIT__CHANNEL_CAPACITY=60
KX_AUTO_RATE_LIMIT__CHANNEL_REFILL_PER_MINUTE=600.0

# ----------------------------------------------------------------------------------------------------
# §8.1 STOP flow (these three are overwritten at start-up by the CRM settings optout.*).
KX_AUTO_OPTOUT__ASK_REASON=false
KX_AUTO_OPTOUT__LIVE_MINUTES=10
KX_AUTO_OPTOUT__UNCLEAR_ANSWER_HOURS=24

# ----------------------------------------------------------------------------------------------------
# Misc automation. PRICE_SOURCES = JSON list (v2 price scraping, off by default). COMPANY_NAME is set from company.yaml.
KX_AUTO_PRICE_SOURCES=[]
KX_AUTO_HTTP_TIMEOUT_SECONDS=15.0
KX_AUTO_COMPANY_NAME=
KX_AUTO_PUBLIC_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------------------------------
# App (KX_APP_*): API, CMS link, CORS.
KX_APP_API_PORT=8000
KX_APP_FORWARDED_ALLOW_IPS=127.0.0.1  # server: the Coolify proxy's fixed address on kx-proxy (10.200.0.2, infra H1)
KX_APP_CMS_URL=http://localhost:3000
KX_APP_CMS_API_KEY=  # secret
# M2: CORS_ORIGINS = the CRM screens only (credentials), never the website; CORS_PUBLIC_ORIGINS = the website's
# origins, which may call /v1/public/* only, without credentials
KX_APP_CORS_ORIGINS=["http://localhost:3001"]
KX_APP_CORS_PUBLIC_ORIGINS=[]
# M6: website share of the daily AI budget, all-visitor AI turns a minute, new sessions per IP a day
KX_APP_SPEND_PUBLIC_AI_SHARE=0.30
KX_APP_PUBLIC_TURNS_PER_MINUTE=60
KX_APP_PUBLIC_SESSIONS_PER_IP_PER_DAY=20
KX_APP_PRICE_SECOND_OPINION=true  # M7: FAST-model second opinion on money/quantity replies (fails closed)

# ----------------------------------------------------------------------------------------------------
# AI (D27, D51): Claude API, direct (Sonnet 5.5 money turns, Haiku 5.5 the rest). No sampling parameters are sent;
# effort per tier (empty = code defaults: fast low, smart medium, judge high; OPEN_QUESTIONS #76).
KX_APP_ANTHROPIC_API_KEY=  # secret
KX_APP_GEMINI_API_KEY=  # secret, only with KX_PLATFORM__LLM_STANDBY=gemini
KX_APP_LLM_EFFORT_FAST=
KX_APP_LLM_EFFORT_SMART=
KX_APP_LLM_EFFORT_JUDGE=

# ----------------------------------------------------------------------------------------------------
# Background jobs (D25): Celery broker (empty = KX_REDIS_URL), worker and Beat timings.
KX_APP_CELERY_BROKER_URL=
KX_APP_WORKER_CONCURRENCY=3
KX_APP_BEAT_SWEEP_SECONDS=30.0
KX_APP_RELAY_SECONDS=5.0
KX_APP_CELERY_VISIBILITY_TIMEOUT_SECONDS=7200

# ----------------------------------------------------------------------------------------------------
# Monitoring (D46): OpenTelemetry to SigNoz, the AI audit trail (Phoenix or Langfuse), vendor-switch emails.
KX_APP_OTLP_ENDPOINT=  # server: http://signoz-otel-collector:4318
KX_APP_BEAT_MAX_LAG_SECONDS=300
KX_APP_OPS_ALERT_EMAILS=[]
KX_APP_AI_TRACE_ENDPOINT=  # local: http://localhost:6006/v1/traces (make up-obs)
KX_APP_AI_TRACE_HEADERS={}  # Langfuse: {"Authorization": "Basic <base64 public:secret>"}
KX_APP_PHOENIX_PROJECT=pack

# ----------------------------------------------------------------------------------------------------
# Knowledge search (D47): TEI base URL (no /v1). The model follows KX_PLATFORM__EMBEDDINGS.
KX_APP_EMBEDDING_URL=  # local: http://localhost:8080 (make up-embed)
KX_APP_EMBEDDING_API_KEY=  # secret
KX_APP_EMBEDDING_QUERY_TIMEOUT_SECONDS=2.0
KX_APP_EMBEDDING_INDEX_TIMEOUT_SECONDS=120.0

# ----------------------------------------------------------------------------------------------------
# Website (§6, D53) and voice (D52): Turnstile, LiveKit, the free speech server, free-version call cap.
KX_APP_TURNSTILE_SECRET_KEY=  # secret
KX_APP_LIVEKIT_URL=
KX_APP_LIVEKIT_API_KEY=
KX_APP_LIVEKIT_API_SECRET=  # secret
KX_APP_SPEECH_URL=  # local: http://localhost:8100 (make up-voice)
KX_APP_VOICE_MAX_CONCURRENT_FREE=3
KX_APP_VOICE_IDLE_PROCESSES=2

# ----------------------------------------------------------------------------------------------------
# CMS publish webhook HMAC (§7, D22) = the same value as KX_CMS_WEBHOOK_HMAC in the CMS container.
KX_APP_CMS_WEBHOOK_SECRET=  # secret

# ----------------------------------------------------------------------------------------------------
# Daily spend caps per company (D34, OPEN_QUESTIONS #52): alert at 80 %, degrade at 100 %.
KX_APP_SPEND_AI_USD_PER_DAY=25
KX_APP_SPEND_VOICE_MINUTES_PER_DAY=840
KX_APP_SPEND_WA_TEMPLATES_PER_DAY=870

# ----------------------------------------------------------------------------------------------------
# Quote / Requirement Summary PDFs (D37): chromium, WeasyPrint as backup.
KX_APP_PDF_RENDERER=chromium
KX_APP_CHROMIUM_PATH=/usr/bin/chromium

# ----------------------------------------------------------------------------------------------------
# Migrations (kx migrate): optional overrides.
# KX_DDL_DIR=                      # where db/ddl lives when not next to the app
# KX_MIGRATE_CRM_DSN=              # owner role for DDL, direct to Postgres (default: KX_CRM_DSN, psycopg)
# KX_MIGRATE_AUTOMATION_DSN=
# KX_MIGRATE_AGENTS_DSN=

# ----------------------------------------------------------------------------------------------------
# Voice worker (kx voice): the LiveKit plug-ins read these names directly (D52).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=  # secret
DEEPGRAM_API_KEY=  # secret - speech-to-text, paid version (Deepgram Nova-3)
ELEVEN_API_KEY=  # secret - text-to-speech, paid version (ElevenLabs Flash); also Tamil in the free version

# ----------------------------------------------------------------------------------------------------
# Container health check (docker/healthcheck.py; set per service in infra/server/stacks/compose.app.yml). The image
# runs `kx <command>`; KX_PROCESS only tells the health check whether to probe HTTP.
KX_PROCESS=api  # api | worker | beat | voice | migrate (only api has an HTTP port)
KX_API_PORT=8000  # health check port (falls back to KX_APP_API_PORT)
KX_HEALTH_PATH=/healthz

# ----------------------------------------------------------------------------------------------------
# CMS container (Payload, separate repo/image) - listed so both sides use the same webhook secret.
# DATABASE_URI=postgresql://pack_cms_app:dev@localhost:5432/pack_cms
# PAYLOAD_SECRET=
# KX_CMS_WEBHOOK_HMAC=             # = KX_APP_CMS_WEBHOOK_SECRET
# KX_API_HOOK_URL=http://localhost:8000/webhooks/cms
