# Arifaa Pack app environment on the dedicated server (copy to Coolify; mark every *KEY / *SECRET / *PASSWORD /
# *TOKEN / DSN as encrypted). Full key list with comments: the root .env.example. Docs: docs/DEPLOYMENT.md.
# The filled-in file lives outside the Git checkout (H5): /opt/kx/secrets/pack.env (root, 0600; KX_ENV_FILE).
# Never commit it: infra/server/stacks/env/*.env is git-ignored.

# ---- paid / free version per field (D41, docs/PLATFORM_MODES.md)
# client decision 18 Nov: free first (self-hosted speech, Stalwart mail); switch a field to paid later, e.g.
# KX_PLATFORM__TTS=paid, no code change (docs/PLATFORM_MODES.md)
KX_PLATFORM_PLAN=free
# KX_PLATFORM__STT=free
# KX_PLATFORM__TTS=free
KX_PLATFORM__EMBEDDINGS=bge-m3
KX_PLATFORM__AI_TRACE=phoenix
# gemini = Gemini 3.8 Flash answers when Claude is down (18 Nov client decision); needs KX_APP_GEMINI_API_KEY
# (a PAID key) and `kx evals --vendor gemini` passing first
KX_PLATFORM__LLM_STANDBY=none

# ---- core
KX_ENV=production
KX_COMPANY_CODE=pack
KX_COMPANY_TIMEZONE=Asia/Dubai
KX_LOG_JSON=true
# the app goes through PgBouncer (D48); migrations go direct to postgres:5432
KX_DB_PGBOUNCER=true
KX_CRM_DSN=postgresql+asyncpg://pack_crm_app:CHANGE@pgbouncer:6432/pack_crm
KX_AUTOMATION_DSN=postgresql+asyncpg://pack_automation_app:CHANGE@pgbouncer:6432/pack_automation
KX_AGENTS_DSN=postgresql+asyncpg://pack_agents_app:CHANGE@pgbouncer:6432/pack_agents
KX_MIGRATE_CRM_DSN=postgresql+psycopg://pack_crm_app:CHANGE@postgres:5432/pack_crm
KX_MIGRATE_AUTOMATION_DSN=postgresql+psycopg://pack_automation_app:CHANGE@postgres:5432/pack_automation
KX_MIGRATE_AGENTS_DSN=postgresql+psycopg://pack_agents_app:CHANGE@postgres:5432/pack_agents
# Redis requires a password (H1): CHANGE = REDIS_PASSWORD of compose.app.yml (openssl rand -hex 32, URL-safe)
KX_REDIS_URL=redis://:CHANGE@redis:6379/0
KX_APP_CELERY_BROKER_URL=redis://:CHANGE@redis:6379/8
# 32+ random characters (openssl rand -hex 32); production refuses to start with a placeholder
KX_SERVICE_TOKEN_SECRET=CHANGE
KX_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
# uvicorn trusts X-Forwarded-* only from the Coolify proxy: its fixed address on the kx-proxy network
# (infra/server/README.md §2: docker network create --subnet 10.200.0.0/24 ... kx-proxy, proxy at 10.200.0.2).
# Never `*`: every container on a shared network could then claim any client IP.
KX_APP_FORWARDED_ALLOW_IPS=10.200.0.2

# ---- staff login (D26)
KX_JWT_ISSUER=https://api.arifapack.com
KX_JWT_PRIVATE_KEY=CHANGE
KX_AUTH__ENCRYPTION_KEY=CHANGE

# ---- files on Cloudflare R2 (D45)
KX_STORAGE__ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
KX_STORAGE__ACCESS_KEY_ID=CHANGE
KX_STORAGE__SECRET_ACCESS_KEY=CHANGE
KX_STORAGE__BUCKET=arifapack

# ---- retention (D48, OPEN_QUESTIONS #73)
KX_RETENTION__PLUMBING_DAYS=30
KX_RETENTION__FAILED_JOB_DAYS=90
KX_RETENTION__AGENT_RUNS_MONTHS=13
KX_RETENTION__PARTITION_HOT_MONTHS=6

# ---- AI (D27, D51)
KX_APP_ANTHROPIC_API_KEY=CHANGE
# KX_APP_GEMINI_API_KEY=
KX_APP_EMBEDDING_URL=http://embeddings:80

# ---- voice (D52): paid plug-ins read their own keys; the free engines are the speech server
LIVEKIT_URL=wss://voice.arifapack.com
LIVEKIT_API_KEY=CHANGE
LIVEKIT_API_SECRET=CHANGE
KX_APP_LIVEKIT_URL=wss://voice.arifapack.com
KX_APP_LIVEKIT_API_KEY=CHANGE
KX_APP_LIVEKIT_API_SECRET=CHANGE
KX_APP_SPEECH_URL=http://speech:8100
KX_APP_VOICE_MAX_CONCURRENT_FREE=3
DEEPGRAM_API_KEY=CHANGE
ELEVEN_API_KEY=CHANGE

# ---- channels
KX_AUTO_PUBLIC_BASE_URL=https://api.arifapack.com
KX_AUTO_WHATSAPP__PHONE_NUMBER_ID=CHANGE
KX_AUTO_WHATSAPP__ACCESS_TOKEN=CHANGE
KX_AUTO_WHATSAPP__APP_SECRET=CHANGE
KX_AUTO_WHATSAPP__VERIFY_TOKEN=CHANGE
KX_AUTO_SES__FROM_ADDRESS=sales@arifapack.com
KX_AUTO_SES__REGION=me-central-1
AWS_ACCESS_KEY_ID=CHANGE
AWS_SECRET_ACCESS_KEY=CHANGE
KX_AUTO_STALWART__URL=http://stalwart:8080
KX_AUTO_STALWART__USERNAME=sales@arifapack.com
KX_AUTO_STALWART__PASSWORD=CHANGE
# Not here (M13): KX_SES_SMTP_PASSWORD and KX_STALWART_RECOVERY_ADMIN belong to the mail stack only (Coolify
# variables of the kx-mail resource, compose.mail.yml); this file is loaded into every app container.
KX_AUTO_TELNYX__API_KEY=CHANGE
KX_AUTO_TELNYX__ACCOUNT_SID=CHANGE
KX_AUTO_TELNYX__FROM_NUMBER=+971XXXXXXXXX
KX_AUTO_TELNYX__PUBLIC_KEY=CHANGE
# 32+ random characters (openssl rand -hex 32); production refuses to start with a placeholder
KX_AUTO_TELNYX__CALLBACK_SECRET=CHANGE

# ---- monitoring (D46)
KX_APP_OTLP_ENDPOINT=http://signoz-otel-collector:4318
KX_APP_AI_TRACE_ENDPOINT=http://phoenix:6006/v1/traces
# Phoenix runs with auth (compose.obs.yml): a system API key created on Phoenix's Settings page
KX_APP_AI_TRACE_HEADERS={"Authorization":"Bearer CHANGE"}
KX_APP_PHOENIX_PROJECT=pack
KX_APP_OPS_ALERT_EMAILS=["CHANGE@arifapack.com"]

# ---- website (§6, D53)
KX_APP_TURNSTILE_SECRET_KEY=CHANGE
KX_APP_CORS_ORIGINS=["https://www.arifapack.com","https://crm.arifapack.com"]
KX_APP_CMS_URL=http://cms:3000
KX_APP_CMS_API_KEY=CHANGE
KX_APP_CMS_WEBHOOK_SECRET=CHANGE
# 18 Nov: automatic daily FX rates for quotes in other currencies (false = the manager enters rates)
KX_APP_FX_RATES_AUTO=true
