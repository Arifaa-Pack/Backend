# Payload CMS (website admin, §7) environment for company `pack` (compose.app.yml service `cms`; image from the
# CMS repo). Copy to Coolify and mark every value below as encrypted. Same keys as the CMS block of the root
# .env.example. The CMS connects to Postgres directly (outside the app's PgBouncer pools, docs/DATABASE.md §3).
# The filled-in file lives outside the Git checkout (H5): /opt/kx/secrets/pack-cms.env (root, 0600; KX_CMS_ENV_FILE).
DATABASE_URI=postgresql://pack_cms_app:CHANGE@postgres:5432/pack_cms
PAYLOAD_SECRET=CHANGE
# = KX_APP_CMS_WEBHOOK_SECRET in env/pack.env (the app checks this HMAC on /webhooks/cms)
KX_CMS_WEBHOOK_HMAC=CHANGE
KX_API_HOOK_URL=http://api:8000/webhooks/cms
